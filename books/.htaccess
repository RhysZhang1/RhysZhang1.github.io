# ============================================================
#  books/ 目录保护：禁止直接执行脚本类文件
#  书库文件（txt/epub/pdf）正常对外提供，仅封死脚本执行面
# ============================================================
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
